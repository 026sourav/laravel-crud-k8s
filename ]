apiVersion: apps/v1
kind: Deployment
metadata: 
 name: crud-deployment
 namespace: laravel-crud
spec:
  replicas: 1
  selector:
    matchLabels:
      app: laravel-crud
  template:
    metadata:
      labels:
        app: laravel-crud
    spec:
      containers:
        - name: laravel-crud-container
          image: sourav1911/laravel-crud-app
          ports: 
          - containerPort: 80
